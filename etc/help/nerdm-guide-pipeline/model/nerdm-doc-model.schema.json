{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.nist.gov/schemas/nerdm-doc-model.schema.json",
  "title": "NERDm Documentation Model",
  "description": "A normalized documentation model for rendering the NERDm guide and exposing structured documentation indexes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "modelVersion",
    "title",
    "description",
    "generatedFrom",
    "typeGroups",
    "types",
    "toc"
  ],
  "properties": {
    "modelVersion": {
      "type": "string",
      "description": "Version of this documentation model contract."
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generatedFrom": {
      "$ref": "#/$defs/generatedFrom"
    },
    "typeGroups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/typeGroup"
      }
    },
    "types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/typeDoc"
      }
    },
    "toc": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tocEntry"
      }
    },
    "glossary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/glossaryEntry"
      }
    }
  },
  "$defs": {
    "generatedFrom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "sourceFormat"
      ],
      "properties": {
        "source": {
          "type": "string",
          "description": "Primary local source used to create this documentation model."
        },
        "sourceFormat": {
          "type": "string",
          "enum": [
            "nerdm-view",
            "json-schema",
            "manual"
          ]
        },
        "generator": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "typeGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        }
      }
    },
    "typeDoc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "label",
        "group",
        "valueType",
        "displayType",
        "description",
        "brief",
        "anchor",
        "properties"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "group": {
          "$ref": "#/$defs/id"
        },
        "valueType": {
          "type": "string"
        },
        "displayType": {
          "type": "string"
        },
        "description": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "brief": {
          "type": "string"
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        },
        "usage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/usage"
          }
        },
        "inheritsFrom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/propertyDoc"
          }
        },
        "source": {
          "$ref": "#/$defs/sourceRef"
        }
      }
    },
    "propertyDoc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "label",
        "parentType",
        "value",
        "description",
        "brief",
        "anchor"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "parentType": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/valueDescriptor"
        },
        "description": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "brief": {
          "type": "string"
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        },
        "required": {
          "type": "boolean"
        },
        "inheritedFrom": {
          "anyOf": [
            {
              "$ref": "#/$defs/inheritanceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "schemaNotes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "readerNotes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowedValues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/allowedValue"
          }
        },
        "source": {
          "$ref": "#/$defs/sourceRef"
        }
      }
    },
    "valueDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonType",
        "display"
      ],
      "properties": {
        "jsonType": {
          "type": "string"
        },
        "display": {
          "type": "string"
        },
        "itemType": {
          "type": [
            "string",
            "null"
          ]
        },
        "objectType": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "template",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "template": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "allowedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "description"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "inheritanceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "property",
        "anchor"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "property": {
          "type": "string"
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "jsonPointer": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tocEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "anchor",
        "level"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        },
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tocEntry"
          }
        }
      }
    },
    "glossaryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "term",
        "definition",
        "anchor"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "term": {
          "type": "string"
        },
        "definition": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9@][A-Za-z0-9_.:@-]*$"
    },
    "anchor": {
      "type": "string",
      "pattern": "^[A-Za-z@][A-Za-z0-9_.:@-]*$"
    }
  }
}
